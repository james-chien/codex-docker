# syntax=docker/dockerfile:1
# Generated by scripts/generate-dockerfile.mts. Update the config or generator to make changes.

FROM node:trixie-slim AS node-runtime
FROM python:slim-trixie AS python-runtime
FROM golang:trixie AS go-runtime
FROM rust:trixie AS rust-runtime
FROM openjdk:28-ea-slim-trixie AS java-runtime
FROM gcc:trixie AS gcc-runtime
FROM ruby:slim-trixie AS ruby-runtime
FROM php:cli-trixie AS php-runtime

FROM swift:trixie AS development

RUN apt-get -o APT::Update::Error-Mode=any update \
    && apt-get install -y --no-install-recommends ca-certificates curl git gnupg libatomic1 libstdc++6 wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/ /usr/local/
COPY --from=python-runtime /usr/local/ /usr/local/
COPY --from=go-runtime /usr/local/go/ /usr/local/go/
ENV PATH=/usr/local/go/bin:$PATH
COPY --from=rust-runtime /usr/local/cargo/ /usr/local/cargo/
COPY --from=rust-runtime /usr/local/rustup/ /usr/local/rustup/
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=$CARGO_HOME/bin:$PATH
COPY --from=java-runtime /usr/local/openjdk-28/ /usr/local/openjdk-28/
ENV JAVA_HOME=/usr/local/openjdk-28
ENV PATH=$JAVA_HOME/bin:$PATH
COPY --from=gcc-runtime /usr/local/ /usr/local/
COPY --from=gcc-runtime /etc/ld.so.conf.d/000-local-lib.conf /etc/ld.so.conf.d/
COPY --from=ruby-runtime /usr/local/ /usr/local/
ENV GEM_HOME=/usr/local/bundle BUNDLE_APP_CONFIG=/usr/local/bundle
ENV PATH=$GEM_HOME/bin:$PATH
COPY --from=php-runtime /usr/local/ /usr/local/
ENV PHP_INI_DIR=/usr/local/etc/php

RUN --mount=type=bind,source=docker/scripts,target=/tmp/scripts \
    --mount=type=cache,target=/root/.npm \
    set -eu; \
    ldconfig; \
    for script in 10-node.sh 20-python.sh 60-gcc.sh 70-ruby.sh 80-php.sh 90-swift.sh; do \
        echo "==> Running $script"; \
        sh "/tmp/scripts/$script"; \
    done

RUN node --version \
    && npm --version \
    && python3 --version \
    && python3 -m pip --version \
    && go version \
    && rustc --version \
    && cargo --version \
    && java --version \
    && javac --version \
    && gcc --version \
    && g++ --version \
    && ruby --version \
    && bundle --version \
    && php --version \
    && swift --version \
    && swift package --version

RUN mkdir -p /root/.codex /root/.npm
ENV CODEX_VERSION=latest
COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=644 scripts/codex-shell.sh /etc/profile.d/codex-shell.sh
RUN printf '\n# Load Codex shell helpers\n[ -f /etc/profile.d/codex-shell.sh ] && . /etc/profile.d/codex-shell.sh\n' >> /root/.bashrc

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
