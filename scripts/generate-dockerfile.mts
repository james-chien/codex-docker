import { constants, readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

type Runtime = {
    image?: string;
    setup?: string[];
    installer?: string;
    checks?: string[];
};

const copyLocal = (runtime: string) => 'COPY --from=' + runtime + '-runtime /usr/local/ /usr/local/';

const runtimes: Record<string, Runtime> = {
    node: { installer: '10-node.sh' },
    python: {
        image: 'python:slim-trixie',
        setup: [copyLocal('python')],
        installer: '20-python.sh',
        checks: ['python3 --version', 'python3 -m pip --version'],
    },
    go: {
        image: 'golang:trixie',
        setup: [
            'COPY --from=go-runtime /usr/local/go/ /usr/local/go/',
            'ENV PATH=/usr/local/go/bin:$PATH',
        ],
        checks: ['go version'],
    },
    rust: {
        image: 'rust:trixie',
        setup: [
            'COPY --from=rust-runtime /usr/local/cargo/ /usr/local/cargo/',
            'COPY --from=rust-runtime /usr/local/rustup/ /usr/local/rustup/',
            'ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo',
            'ENV PATH=$CARGO_HOME/bin:$PATH',
        ],
        checks: ['rustc --version', 'cargo --version'],
    },
    java: {
        image: 'openjdk:28-ea-slim-trixie',
        setup: [
            'COPY --from=java-runtime /usr/local/openjdk-28/ /usr/local/openjdk-28/',
            'ENV JAVA_HOME=/usr/local/openjdk-28',
            'ENV PATH=$JAVA_HOME/bin:$PATH',
        ],
        checks: ['java --version', 'javac --version'],
    },
    gcc: {
        image: 'gcc:trixie',
        setup: [
            copyLocal('gcc'),
            'COPY --from=gcc-runtime /etc/ld.so.conf.d/000-local-lib.conf /etc/ld.so.conf.d/',
        ],
        installer: '60-gcc.sh',
        checks: ['gcc --version', 'g++ --version'],
    },
    ruby: {
        image: 'ruby:slim-trixie',
        setup: [
            copyLocal('ruby'),
            'ENV GEM_HOME=/usr/local/bundle BUNDLE_APP_CONFIG=/usr/local/bundle',
            'ENV PATH=$GEM_HOME/bin:$PATH',
        ],
        installer: '70-ruby.sh',
        checks: ['ruby --version', 'bundle --version'],
    },
    php: {
        image: 'php:cli-trixie',
        setup: [copyLocal('php'), 'ENV PHP_INI_DIR=/usr/local/etc/php'],
        installer: '80-php.sh',
        checks: ['php --version'],
    },
    swift: {
        installer: '90-swift.sh',
        checks: ['swift --version', 'swift package --version'],
    },
};

function parseConfig(config: unknown) {
    if (!config || typeof config !== 'object' || !('runtimes' in config)
        || !Array.isArray(config.runtimes)
        || Object.keys(config).some((key) => key !== 'runtimes' && key !== 'codexVersion')) {
        throw new Error('Expected a JSON object with a "runtimes" array and optional "codexVersion".');
    }

    const codexVersion = 'codexVersion' in config ? config.codexVersion : 'latest';
    if (typeof codexVersion !== 'string' || codexVersion.trim() !== codexVersion || (codexVersion !== 'latest'
        && !/^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/.test(codexVersion))) {
        throw new Error('Expected "codexVersion" to be "latest" or an exact version, such as "0.171.0".');
    }

    const selected = new Set<string>();
    for (const runtime of config.runtimes) {
        if (typeof runtime !== 'string' || !Object.hasOwn(runtimes, runtime)) {
            throw new Error('Unknown runtime ' + JSON.stringify(runtime)
                + '. Choose from ' + Object.keys(runtimes).join(', ') + '.');
        }
        if (selected.has(runtime)) {
            throw new Error('Duplicate runtime ' + JSON.stringify(runtime) + '.');
        }
        selected.add(runtime);
    }
    return { selected, codexVersion };
}

export function generateDockerfile(config: unknown): string {
    const { selected, codexVersion } = parseConfig(config);
    const enabled = Object.entries(runtimes).filter(([runtime]) => selected.has(runtime));
    const installers = enabled.flatMap(([, runtime]) => runtime.installer ?? []);
    const checks = ['node --version', 'npm --version',
        ...enabled.flatMap(([, runtime]) => runtime.checks ?? [])];
    const continuation = ' ' + String.fromCharCode(92) + '\n';

    const lines = [
        '# syntax=docker/dockerfile:1',
        '# Generated by scripts/generate-dockerfile.mts. Update the config or generator to make changes.',
        '',
        'FROM node:trixie-slim AS node-runtime',
        ...enabled.flatMap(([name, runtime]) =>
            runtime.image ? ['FROM ' + runtime.image + ' AS ' + name + '-runtime'] : []),
        '',
        selected.has('swift') ? 'FROM swift:trixie AS development' : 'FROM debian:trixie-slim AS development',
        '',
        [
            'RUN apt-get -o APT::Update::Error-Mode=any update',
            '    && apt-get install -y --no-install-recommends ca-certificates curl git gnupg libatomic1 libstdc++6 wget',
            '    && rm -rf /var/lib/apt/lists/*',
        ].join(continuation),
        '',
        copyLocal('node'),
        ...enabled.flatMap(([, runtime]) => runtime.setup ?? []),
        '',
    ];

    if (installers.length > 0) {
        const commands = [
            'RUN --mount=type=bind,source=docker/scripts,target=/tmp/scripts',
            ...(selected.has('node') ? ['    --mount=type=cache,target=/root/.npm'] : []),
            '    set -eu;',
            ...(selected.has('gcc') ? ['    ldconfig;'] : []),
            '    for script in ' + installers.join(' ') + '; do',
            '        echo "==> Running $script";',
            '        sh "/tmp/scripts/$script";',
            '    done',
        ];
        lines.push(commands.join(continuation), '');
    }

    lines.push(
        'RUN ' + checks.join(continuation + '    && '),
        '',
        'RUN mkdir -p /root/.codex /root/.npm',
        'ENV CODEX_VERSION=' + codexVersion,
        'COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh',
        'COPY --chmod=644 scripts/codex-shell.sh /etc/profile.d/codex-shell.sh',
        String.raw`RUN printf '\n# Load Codex shell helpers\n[ -f /etc/profile.d/codex-shell.sh ] && . /etc/profile.d/codex-shell.sh\n' >> /root/.bashrc`,
        '',
        'WORKDIR /workspace',
        'ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]',
        'CMD ["/bin/bash"]',
        '',
    );
    return lines.join('\n');
}

function main(args: string[]) {
    const usage = 'Usage: node scripts/generate-dockerfile.mts [--check|--force] [config.json] [output Dockerfile]';
    if (args.length === 1 && ['--help', '-h'].includes(args[0])) {
        console.log(usage);
        return;
    }
    const force = args[0] === '--force';
    const check = args[0] === '--check';
    const paths = force || check ? args.slice(1) : args;
    if (paths.length > 2 || paths.some((arg) => arg.startsWith('-'))) {
        throw new Error(usage);
    }

    const [configPath = 'docker.config.json', outputPath = check ? 'Dockerfile' : 'Dockerfile.generated'] = paths;
    if (resolve(configPath) === resolve(outputPath)) {
        throw new Error('The config and output paths must be different.');
    }
    const config = JSON.parse(readFileSync(configPath, 'utf8'));
    const dockerfile = generateDockerfile(config);
    if (check) {
        if (readFileSync(outputPath, 'utf8') !== dockerfile) {
            throw new Error(outputPath + ' is out of date. Regenerate it with --force using the same paths.');
        }
        console.log(outputPath + ' is up to date.');
        return;
    }
    const create = constants.O_WRONLY | constants.O_CREAT | constants.O_NOFOLLOW;
    writeFileSync(outputPath, dockerfile, {
        flag: create | (force ? constants.O_TRUNC : constants.O_EXCL),
    });
    console.log('Generated ' + outputPath);
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
    try {
        main(process.argv.slice(2));
    } catch (error) {
        console.error(error instanceof Error ? error.message : error);
        process.exitCode = 1;
    }
}
